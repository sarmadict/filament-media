{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sarmadict/filament-media",
    "description": "A reusable Filament 5 media library, filesystem browser, and media picker for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "media",
        "media-library",
        "file-browser",
        "file-upload"
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/pagination": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Sarmadict\\FilamentMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sarmadict\\FilamentMedia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sarmadict\\FilamentMedia\\FilamentMediaServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
